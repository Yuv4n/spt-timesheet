<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>SPT Planner</label>
    <description>Raj / anyone who plans the team week. Full control of planning items, capacity and absences.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <classAccesses><apexClass>PlannerModels</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>TimesheetServiceFactory</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>LocalTimesheetService</apexClass><enabled>true</enabled></classAccesses>

    <objectPermissions>
        <object>Planning_Item__c</object>
        <allowCreate>true</allowCreate><allowRead>true</allowRead><allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete><modifyAllRecords>true</modifyAllRecords><viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Required fields can't carry an explicit fieldPermissions entry - Salesforce always
         grants them read/edit to anyone with object access and rejects the deploy otherwise.
         Omitted here: Item_Type__c, Priority__c, Status__c, Estimate_Hours__c. -->
    <fieldPermissions><field>Planning_Item__c.Case__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Planning_Item__c.Assignee__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Planning_Item__c.Deadline__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Planning_Item__c.Actual_Minutes__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Planning_Item__c.Billable__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
</PermissionSet>
