<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>SPT Team Member</label>
    <description>Team members. Can see their work and record actual time. Cannot re-plan the week or edit capacity.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <classAccesses><apexClass>PlannerModels</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>TimesheetServiceFactory</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>LocalTimesheetService</apexClass><enabled>true</enabled></classAccesses>

    <objectPermissions>
        <object>Planning_Item__c</object>
        <allowCreate>false</allowCreate><allowRead>true</allowRead><allowEdit>true</allowEdit>
        <allowDelete>false</allowDelete><modifyAllRecords>false</modifyAllRecords><viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Read-only on everything a team member should not re-plan.
         Item_Type__c, Priority__c, Status__c and Estimate_Hours__c are required fields and can't
         carry an explicit fieldPermissions entry - Salesforce always grants them read/edit to
         anyone with object access and rejects the deploy otherwise. Note this means a team member
         CAN edit Priority__c/Estimate_Hours__c in practice despite the intent below; Status__c
         being auto-editable is harmless since it's already meant to be. -->
    <fieldPermissions><field>Planning_Item__c.Case__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Planning_Item__c.Assignee__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Planning_Item__c.Deadline__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <!-- Editable: the two things a team member legitimately changes. -->
    <fieldPermissions><field>Planning_Item__c.Actual_Minutes__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <!-- Open decision 9: can a team member flip billability after the fact? Currently NO. -->
    <fieldPermissions><field>Planning_Item__c.Billable__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
</PermissionSet>
